config {
  type: "assertion",
  schema: "fraud_analytics_assertions",
  name: "assert_fct_scored_transactions_fk_destination_account",
  tags: ["fraud-main", "assertions"]
}

select f.transaction_key
from ${ref("fct_scored_transactions")} f
left join ${ref("dim_account")} d
  on f.destination_account_key = d.account_key
where f.destination_account_key is not null
  and d.account_key is null
